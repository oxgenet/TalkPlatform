# LiveKit (セルフホスト)
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# xAI (唯一の外部 SaaS)
XAI_API_KEY=xai-...
TALK_LLM_MODEL=grok-4-fast-non-reasoning
TALK_TTS_VOICE=ara
TALK_LANGUAGE=ja

# Worker (L Harness) へのイベント送信
TALK_WORKER_URL=https://your-worker.workers.dev
CALL_AGENT_SECRET=change-me-at-least-16-chars

# 任意
TALK_SYSTEM_PROMPT_FILE=./prompts/system.ja.md
TALK_OPENING_TEXT=お電話ありがとうございます。こちらは AI アシスタントです。通話は品質向上のため録音されます。担当者におつなぎすることもできますので、お気軽にお申し付けください。ご用件をどうぞ。
TALK_ALLOW_LAB_ROOMS=false

# 占い MCP (コンポーネント層・別サービス/別組織)。空なら無効
TALK_MCP_URL=https://astrology.example.jp/sse
TALK_MCP_TOKEN=tk_change-me-16chars-min
TALK_MCP_TOOLS=start_session,create_chart,get_reading,get_transit,get_sequence_forecast
